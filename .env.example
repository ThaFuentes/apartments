SECRET_KEY=change-me-apt-field-record
PBT_TOKEN_SECRET=change-me-to-another-64-char-random-string
APT_DATA_KEY=

DEBUG_MODE=true
REQUIRE_HTTPS=false
HSTS_DISABLED=1
SESSION_COOKIE_SECURE=false

HOST=127.0.0.1
PORT=8075
SITE_MODE=apt

# Laptop docker MariaDB (see docker-compose.yml). HostM uses cPanel MYSQL_*.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3314
MYSQL_USER=apt_user
MYSQL_PASSWORD=AptUserPass2026!
MYSQL_DATABASE=apt

PBT_TRUSTED_IPS=

# One request never holds a worker long (2026-11-12 pool incident).
# A single DB statement deadline, in seconds. 5 matches the one-worker rule;
# raise it only for a route that stderr.log has already shown as [REQ-SLOW].
# APT_DB_READ_TIMEOUT=5
# Log any Python page slower than this many milliseconds (default 5000; 0=all).
# APT_SLOW_MS=5000
# How long a second write from one person waits for the slot before 429.
# APT_LANE_WAIT_MS=1500
